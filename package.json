{
    "name": "castrum",
    "version": "0.7.0",
    "private": false,
    "description": "Enterprise-grade Bun + Rust runtime: Rust-accelerated FFI primitives, a production-grade HTTP ingress pipeline, validation, hashing, and JSON processing with benchmark-grade performance.",
    "type": "module",
    "main": "index.ts",
    "module": "index.ts",
    "types": "index.ts",
    "license": "MIT",
    "keywords": [
        "bun",
        "rust",
        "napi",
        "ffi",
        "ingress",
        "http",
        "validation",
        "hashing",
        "json",
        "performance",
        "benchmark"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Axylabs/flux-rs.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./index.ts"
    },
    "files": [
        "index.ts",
        "bench.ts",
        "src",
        "rust",
        "Cargo.toml",
        "README.md",
        "*.node"
    ],
    "scripts": {
        "build": "napi build --release --platform",
        "bench": "bun run build && bun bench.ts",
        "check": "bun bench.ts",
        "test": "bun test",
        "build:debug": "napi build --platform",
        "artifacts": "napi artifacts",
        "publish:manual": "node scripts/publish-manual.mjs",
        "publish:manual:dry": "node scripts/publish-manual.mjs --dry-run",
        "prepublishOnly": "node scripts/prepublish.mjs",
        "bench:http": "bun run bench/run-bench.ts",
        "bench:http:smoke": "bun run bench/run-bench.ts smoke",
        "bench:http:stress": "bun run bench/run-bench.ts stress",
        "bench:http:heavy": "bun run bench/run-bench.ts heavy-json",
        "bench:http:crud": "bun run bench/run-bench.ts crud",
        "bench:http:spike": "bun run bench/run-bench.ts spike",
        "bench:http:soak": "bun run bench/run-bench.ts soak",
        "bench:http:storm": "bun run bench/run-bench.ts storm",
        "bench:http:boundary": "bun run bench/run-bench.ts boundary",
        "bench:http:elysia": "bun run bench/run-bench.ts '' elysia",
        "bench:http:ingress": "bun run bench/run-bench.ts '' ingress",
        "bench:http:bun-only": "bun run bench/run-bench.ts '' bun",
        "bench:http:all-heavy": "bun run bench/run-bench.ts 1"
    },
    "dependencies": {
        "crc-32": "^1.2.2",
        "fast-json-patch": "^3.1.1",
        "mime-types": "^3.0.2",
        "validator": "^13.15.35"
    },
    "devDependencies": {
        "@elysia/cors": "^1.4.2",
        "@napi-rs/cli": "^3.7.4",
        "@types/bun": "^1.3.14",
        "@types/mime-types": "^3.0.1",
        "@types/validator": "^13.15.10",
        "elysia": "^1.4.0"
    },
    "engines": {
        "bun": ">=1.1.0"
    },
    "napi": {
        "binaryName": "castrum",
        "targets": [
            "aarch64-apple-darwin",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu"
        ]
    }
}