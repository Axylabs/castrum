{
    "name": "castrum",
    "version": "0.9.0",
    "private": false,
    "description": "Enterprise-grade Bun + Rust runtime: Rust-accelerated FFI primitives, a production-grade HTTP ingress pipeline, validation, hashing, and JSON processing with benchmark-grade performance.",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "license": "MIT",
    "keywords": [
        "bun",
        "rust",
        "napi",
        "ffi",
        "ingress",
        "http",
        "validation",
        "hashing",
        "json",
        "performance",
        "benchmark"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Axylabs/flux-rs.git"
    },
    "homepage": "https://github.com/Axylabs/flux-rs#readme",
    "bugs": {
        "url": "https://github.com/Axylabs/flux-rs/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "bun": "./index.ts",
            "node": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "index.ts",
        "dist",
        "src",
        "docs",
        "README.md",
        "*.node",
        "!src/bench",
        "!src/baseline",
        "!src/data"
    ],
    "scripts": {
        "build": "napi build --release --platform",
        "build:perf": "bash scripts/build-perf.sh",
        "build:js": "bun run build:js:bundle && bun run build:js:types",
        "build:js:bundle": "bun build ./index.ts --target=node --format=esm --outdir=dist",
        "build:js:types": "dts-bundle-generator -o dist/index.d.ts index.ts",
        "bench": "bun run build && bun bench.ts",
        "check": "bun bench.ts",
        "test": "bun test",
        "test:all": "bun test && bun run typecheck && bun run typecheck:test && bun run lint:ci && cargo test --lib",
        "test:coverage": "node scripts/check-coverage.mjs",
        "setup": "bun install && bun run build",
        "test:node": "node --test test/integration/node-smoke.test.mjs test/integration/node-enterprise.test.mjs",
        "verify:install": "node scripts/verify-install.mjs",
        "build:debug": "napi build --platform",
        "lint": "bunx biome check .",
        "lint:fix": "bunx biome check --write .",
        "lint:ci": "bunx biome check . --formatter-enabled=false --assist-enabled=false --error-on-warnings",
        "format": "bunx biome format --write .",
        "typecheck": "bunx tsc --noEmit",
        "typecheck:test": "bunx tsc --noEmit -p tsconfig.test.json",
        "test:rust": "cargo test",
        "deny": "cargo deny check",
        "check:version": "bun scripts/check-version.mjs",
        "check:jsdoc": "bun scripts/check-jsdoc.ts",
        "check:selection": "bun scripts/select-native.ts --check",
        "audit": "bun audit",
        "publish:manual": "node scripts/publish-manual.mjs",
        "publish:manual:dry": "node scripts/publish-manual.mjs --dry-run",
        "prepublishOnly": "bun run build:js && node scripts/prepublish.mjs",
        "check:proven": "bun scripts/check-proven.ts",
        "check:proven:fail": "bun scripts/check-proven.ts --fail",
        "check:annotate": "bun scripts/annotate-performance.ts",
        "check:annotate:dry": "bun scripts/annotate-performance.ts --dry-run",
        "check:docs": "bun run check && bun run check:annotate && bun run check:proven",
        "bench:http": "bun run bench/run-bench.ts",
        "bench:http:smoke": "bun run bench/run-bench.ts smoke",
        "bench:http:stress": "bun run bench/run-bench.ts stress",
        "bench:http:heavy": "bun run bench/run-bench.ts heavy-json",
        "bench:http:crud": "bun run bench/run-bench.ts crud",
        "bench:http:spike": "bun run bench/run-bench.ts spike",
        "bench:http:soak": "bun run bench/run-bench.ts soak",
        "bench:http:storm": "bun run bench/run-bench.ts storm",
        "bench:http:boundary": "bun run bench/run-bench.ts boundary",
        "bench:http:elysia": "bun run bench/run-bench.ts '' elysia",
        "bench:http:ingress": "bun run bench/run-bench.ts '' ingress",
        "bench:http:bun-only": "bun run bench/run-bench.ts '' bun",
        "bench:http:all-heavy": "bun run bench/run-bench.ts 1",
        "bench:startup": "bun run bench/startup.ts",
        "bench:load": "bun run bench/load-phase.ts",
        "bench:ffi": "bun run bench/ffi-all.ts",
        "bench:ffi:load": "bun run bench/ffi-load.ts",
        "bench:ffi:public": "bun run bench/ffi-public.ts",
        "bench:ffi:workers": "bun run bench/ffi-workers.ts",
        "bench:margin": "bun run bench/ffi-margin.ts",
        "bench:router": "bun run bench/router-cost.ts",
        "bench:ingress-cost": "bun run bench/ingress-cost.ts",
        "verify:native:batch": "bun run scripts/verify-native-batch.ts"
    },
    "dependencies": {},
    "peerDependencies": {
        "@types/node": ">=20"
    },
    "peerDependenciesMeta": {
        "@types/node": {
            "optional": true
        }
    },
    "devDependencies": {
        "@elysia/cors": "^1.4.2",
        "@napi-rs/cli": "^3.7.4",
        "@types/bun": "^1.3.14",
        "@types/mime-types": "^3.0.1",
        "@types/validator": "^13.15.10",
        "ajv": "^8.20.0",
        "crc-32": "^1.2.2",
        "dts-bundle-generator": "^9.5.1",
        "elysia": "^1.4.0",
        "fast-json-patch": "^3.1.1",
        "mime-types": "^3.0.2",
        "typescript": "5.9.3",
        "validator": "^13.15.35"
    },
    "overrides": {
        "typescript": "5.9.3"
    },
    "engines": {
        "bun": ">=1.1.0",
        "node": ">=20.3"
    },
    "napi": {
        "binaryName": "castrum",
        "targets": [
            "aarch64-apple-darwin",
            "aarch64-unknown-linux-gnu",
            "aarch64-unknown-linux-musl",
            "x86_64-apple-darwin",
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "x86_64-unknown-linux-musl"
        ]
    }
}